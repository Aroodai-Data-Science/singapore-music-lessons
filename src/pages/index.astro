---
const siteName = import.meta.env.PUBLIC_SITE_NAME || "Singapore Data Hub";
const pageTitle = `${siteName} Fee Benchmark Directory 2026`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={`Comprehensive benchmark comparison and rates directory for ${siteName}.`} />
  
  <!-- JSON-LD Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Table",
    "name": `${siteName} Rates Benchmark`,
    "description": `2026 service fee matrix for ${siteName}.`,
    "publisher": {
      "@type": "Organization",
      "name": `${siteName} Data Hub`
    }
  })} />

  <style>
    body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; max-width: 960px; margin: 0 auto; padding: 24px; color: #0f172a; }
    h1 { font-size: 2.2rem; color: #0f172a; margin-bottom: 8px; }
    h2 { font-size: 1.5rem; color: #1e293b; margin-top: 32px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.95rem; }
    th, td { border: 1px solid #cbd5e1; padding: 12px; text-align: left; }
    th { background-color: #f1f5f9; font-weight: 600; }
    .meta-box { background: #f0f9ff; border-left: 4px solid #0284c7; padding: 16px; margin: 24px 0; border-radius: 0 8px 8px 0; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0; }
    .card { border: 1px solid #e2e8f0; padding: 16px; border-radius: 8px; background: #fafafa; }
    .form-box { background: #f8fafc; border: 1px solid #cbd5e1; padding: 24px; border-radius: 8px; margin-top: 40px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
    .submit-btn { background: #0284c7; color: white; border: none; padding: 12px 24px; border-radius: 4px; font-weight: 600; cursor: pointer; }
  </style>
</head>
<body>
  <header style="margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
    <strong>🇸🇬 {siteName} Data Hub</strong>
  </header>

  <main>
    <h1>{siteName} Directory</h1>
    
    <div class="meta-box">
      <strong>Market Summary:</strong> Rates and services directory for <strong>{siteName}</strong>. Rates vary based on credentials, service scope, and locations.
    </div>

    <h2>1. Monthly Rates & Service Benchmark</h2>
    <table>
      <thead>
        <tr>
          <th>Category</th>
          <th>Basic Tier</th>
          <th>Standard Tier</th>
          <th>Premium Tier</th>
          <th>Specialist / Diploma</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Standard Package</strong></td>
          <td>$140 – $200 SGD</td>
          <td>$180 – $280 SGD</td>
          <td>$300 – $480 SGD</td>
          <td>$550 – $800+ SGD</td>
        </tr>
        <tr>
          <td><strong>Advanced Package</strong></td>
          <td>$160 – $220 SGD</td>
          <td>$200 – $320 SGD</td>
          <td>$340 – $520 SGD</td>
          <td>$600 – $900 SGD</td>
        </tr>
        <tr>
          <td><strong>Custom Service</strong></td>
          <td>$140 – $190 SGD</td>
          <td>$170 – $260 SGD</td>
          <td>$280 – $420 SGD</td>
          <td>$500 – $700 SGD</td>
        </tr>
      </tbody>
    </table>

    <h2>2. Key Providers & Locations</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Central Hub</h3>
        <p><strong>Locations:</strong> Forum, Orchard, Vivocity</p>
        <p>Specializes in tailored options with customized scheduling.</p>
      </div>
      <div class="card">
        <h3>East / West Hub</h3>
        <p><strong>Locations:</strong> Tampines, Jurong, Plaza Singapura</p>
        <p>Known for structured group programs and consultations.</p>
      </div>
      <div class="card">
        <h3>Heartland Hub</h3>
        <p><strong>Locations:</strong> Toa Payoh, Bedok, Bishan</p>
        <p>Offers accessible, budget-conscious packages across heartland hubs.</p>
      </div>
    </div>

    <h2>3. Request Information / Quotation</h2>
    <div class="form-box">
      <p>Need help selecting an accredited provider matching your location and budget? Request a fee quotation below.</p>
      <form action="https://formspree.io/f/xkjnrzvk" method="POST">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" required placeholder="e.g. Sarah Tan" />
        </div>
        <div class="form-group">
          <label for="email">Email or WhatsApp Number</label>
          <input type="text" id="email" name="contact" required placeholder="+65 9123 4567 or email@domain.com" />
        </div>
        <div class="form-group">
          <label for="service">Service Category</label>
          <select id="service" name="service">
            <option value="basic">Basic Inquiry</option>
            <option value="standard">Standard Consultation</option>
            <option value="premium">Premium Support</option>
            <option value="other">Other</option>
          </select>
        </div>
        <button type="submit" class="submit-btn">Get Fee Recommendations</button>
      </form>
    </div>
  </main>
</body>
</html>

---
const siteName = import.meta.env.PUBLIC_SITE_NAME || "Singapore Data Hub";
const conversionMode = import.meta.env.PUBLIC_CONVERSION_MODE || "email";
const mohDisclaimer = import.meta.env.PUBLIC_MOH_DISCLAIMER === "true";

const pageTitle = `${siteName} Directory & Rates 2026`;
const siteLower = siteName.toLowerCase();

// 1. Regional Logic
const isCebu = siteLower.includes("cebu");
const locationCentral = isCebu ? "Cebu City, IT Park, Ayala Center" : "Orchard, Novena, Marina Bay";
const locationRegional = isCebu ? "Mandaue, Lapu-Lapu, Talisay" : "Jurong, Tampines, Woodlands";
const locationHeartland = isCebu ? "Consolacion, Liloan, Minglanilla" : "Bedok, Toa Payoh, Ang Mo Kio";

// 2. Niche Data Engine
let marketSummary = "";
let tableHeaders = ["Service Category", "Basic / Entry", "Standard Tier", "Premium / Specialist"];
let tableRows: { category: string; basic: string; standard: string; premium: string }[] = [];
let providers: { name: string; locations: string; description: string }[] = [];

if (siteLower.includes("beauty clinic")) {
  marketSummary = "Aesthetic clinic rates in Singapore vary by doctor accreditation, FDA/HSA-approved medical technology, and treatment complexity. Prices shown exclude GST and doctor consultation fees.";
  tableHeaders = ["Treatment Type", "Single Session", "3-Session Package", "Doctor Specialist Tier"];
  tableRows = [
    { category: "Medical Facial / Laser Toning", basic: "$150 – $250 SGD", standard: "$400 – $650 SGD", premium: "$800 – $1,200 SGD" },
    { category: "HIFU / Ultherapy Skin Tightening", basic: "$600 – $900 SGD", standard: "$1,500 – $2,400 SGD", premium: "$3,000 – $4,500 SGD" },
    { category: "Botox / Dermal Fillers (per syringe)", basic: "$250 – $450 SGD", standard: "$600 – $950 SGD", premium: "$1,200 – $1,800 SGD" }
  ];
  providers = [
    { name: "Novena Medical Center Aesthetics", locations: "Novena Specialist Center, Orchard", description: "MOH-registered aesthetic medical practices focusing on lasers, pigmentation, and anti-aging care." },
    { name: "Orchard Medical Aesthetic Suites", locations: "Wheelock Place, Paragon Shopping Centre", description: "Doctor-led medical aesthetic clinics specializing in non-invasive skin tightening and facial contouring." },
    { name: "Heartland Medical Skin Clinics", locations: "Tampines Regional Centre, Jurong East", description: "Accessible aesthetic GP practices providing medical acne treatments and laser therapy." }
  ];
} else if (siteLower.includes("beauty salon")) {
  marketSummary = "Beauty salon services range from facial extractions and lash extensions to full-body treatments across shopping malls and heartland hubs.";
  tableHeaders = ["Service Type", "Trial / First Visit", "Standard Session", "Member Package"];
  tableRows = [
    { category: "Deep Cleansing Extraction Facial", basic: "$68 – $98 SGD", standard: "$120 – $180 SGD", premium: "$450 – $800 SGD" },
    { category: "Lash Extensions / Brow Lash Lift", basic: "$58 – $88 SGD", standard: "$98 – $150 SGD", premium: "$350 – $600 SGD" },
    { category: "Full Body Massage / Slimming Therapy", basic: "$88 – $128 SGD", standard: "$150 – $220 SGD", premium: "$600 – $1,100 SGD" }
  ];
  providers = [
    { name: "Orchard Brow & Lash Studio", locations: "Far East Plaza, Midpoint Orchard", description: "Boutique salon specializing in volume lash extensions, brow embroidery, and lash lifts." },
    { name: "Central Skin & Wellness Spa", locations: "Marina Square, Suntec City", description: "Full-service salon providing hydration facials, body scrubs, and relaxation therapies." },
    { name: "Heartland Beauty Express", locations: "Bedok Mall, Ang Mo Kio Hub", description: "Affordable neighborhood facial and waxing salons with no hard-selling packages." }
  ];
} else if (siteLower.includes("caregiver")) {
  marketSummary = "Caregiver rates depend on required medical scope (e.g., tube feeding, dementia care), hourly vs. live-in shift arrangements, and nursing certifications.";
  tableHeaders = ["Caregiving Level", "Hourly Shift", "12-Hour Day/Night", "Monthly Live-In / Full-Time"];
  tableRows = [
    { category: "Elderly Home Care (ADL Assistance)", basic: "$22 – $30 / hr", standard: "$180 – $250 / day", premium: "$1,200 – $1,800 / mo" },
    { category: "Dementia & Stroke Rehabilitation", basic: "$28 – $38 / hr", standard: "$220 – $320 / day", premium: "$1,800 – $2,500 / mo" },
    { category: "Private Registered Nurse (Medical)", basic: "$40 – $60 / hr", standard: "$350 – $500 / day", premium: "$3,000 – $4,500 / mo" }
  ];
  providers = [
    { name: "Central Home Nursing Services", locations: locationCentral, description: "Professional nursing agency providing home visit consultations and post-surgery care." },
    { name: "ElderCare Support Network", locations: locationRegional, description: "Dedicated respite caregivers assisting seniors with mobility, meal prep, and daily living activities." },
    { name: "Heartland Caregiver Agency", locations: locationHeartland, description: "Flexible shift caregiving for families needing part-time companion or night support." }
  ];
} else if (siteLower.includes("counselling")) {
  marketSummary = "Professional mental health counseling rates vary by clinical psychologist vs. counselor accreditation (SPS/SAC) and individual vs. couples format.";
  tableHeaders = ["Session Type", "Graduate Counselor", "Senior Therapist (SAC)", "Clinical Psychologist"];
  tableRows = [
    { category: "Individual Therapy (50 mins)", basic: "$120 – $160 SGD", standard: "$180 – $240 SGD", premium: "$250 – $350 SGD" },
    { category: "Couples / Marriage Counseling", basic: "$180 – $220 SGD", standard: "$240 – $320 SGD", premium: "$350 – $480 SGD" },
    { category: "Family Therapy Session", basic: "$200 – $260 SGD", standard: "$280 – $360 SGD", premium: "$400 – $550 SGD" }
  ];
  providers = [
    { name: "Central Psychological Practice", locations: "Novena Medical Center, Raffles Place", description: "Private mental health practice offering evidence-based CBT, trauma therapy, and stress management." },
    { name: "Family & Relationship Wellness Center", locations: "Orchard, Tanjong Pagar", description: "Specialists in couples therapy, marriage guidance, and interpersonal conflict resolution." },
    { name: "Community Counseling Network", locations: "Bishan, Jurong East", description: "Accessible therapy services offering sliding-scale options for individuals and teens." }
  ];
} else if (siteLower.includes("adhd")) {
  marketSummary = "ADHD screening, diagnostic assessments, and executive function coaching rates across private psychiatric clinics and psychological centers.";
  tableHeaders = ["Assessment / Therapy", "Initial Consult", "Full Assessment Package", "Follow-Up Coaching"];
  tableRows = [
    { category: "Adult ADHD Assessment", basic: "$250 – $350 SGD", standard: "$1,200 – $1,800 SGD", premium: "$180 – $280 / session" },
    { category: "Child & Adolescent Screening", basic: "$220 – $300 SGD", standard: "$1,000 – $1,600 SGD", premium: "$150 – $250 / session" },
    { category: "Executive Function Coaching", basic: "$140 – $180 SGD", standard: "$500 – $800 (4-pack)", premium: "$180 – $250 / session" }
  ];
  providers = [
    { name: "Child & Adult Neurodiversity Clinic", locations: "Novena, Orchard", description: "Specialized psychiatric and psychological assessments for ADHD, autism, and learning differences." },
    { name: "Behavioral & Executive Function Center", locations: "Tanglin, Bukit Timah", description: "Coaching and cognitive behavioral therapy (CBT) tailored for working adults and students with ADHD." },
    { name: "Heartland Pediatric Development Clinic", locations: "Tampines, Jurong", description: "Child therapy services collaborating with schools and families for behavioral support." }
  ];
} else if (siteLower.includes("rides")) {
  marketSummary = "Transportation and car rental rates in Cebu, including airport transfers, daily private driver hires, and regional island tours.";
  tableHeaders = ["Vehicle Class", "Airport Transfer", "Half-Day Hire (4 Hrs)", "Full-Day Hire (8-10 Hrs)"];
  tableRows = [
    { category: "Sedan (Vios / City - 3 Pax)", basic: "₱800 – ₱1,000 PHP", standard: "₱1,800 – ₱2,200 PHP", premium: "₱3,000 – ₱3,500 PHP" },
    { category: "MPV / SUV (Innova - 6 Pax)", basic: "₱1,200 – ₱1,500 PHP", standard: "₱2,500 – ₱3,000 PHP", premium: "₱4,000 – ₱4,800 PHP" },
    { category: "Passenger Van (HiAce - 12 Pax)", basic: "₱1,800 – ₱2,200 PHP", standard: "₱3,500 – ₱4,200 PHP", premium: "₱5,000 – ₱6,500 PHP" }
  ];
  providers = [
    { name: "Cebu Airport & City Express", locations: "Mactan-Cebu Intl Airport, IT Park", description: "24/7 private transfers between Mactan airport, Cebu City hotels, and business districts." },
    { name: "Island Tour & Private Van Rentals", locations: "Ayala Center, Mandaue City", description: "Chauffeur-driven van rentals for Oslob whale shark tours, Moalboal, and city sightseeing." },
    { name: "Northern & Southern Cebu Mobility", locations: "Talisay, Lapu-Lapu City", description: "Long-distance private transport across Cebu province for events and corporate travel." }
  ];
} else {
  // Default / Music Lessons Fallback
  marketSummary = "Tuition rates and academy fee directory for private lessons, studio packages, and certified examination preparations.";
  tableHeaders = ["Category", "Beginner Tier", "Intermediate (Gr 1-4)", "Advanced / Diploma"];
  tableRows = [
    { category: "Classical Piano / Keyboard", basic: "$140 – $200 SGD", standard: "$180 – $280 SGD", premium: "$550 – $800+ SGD" },
    { category: "Violin & String Instruments", basic: "$160 – $220 SGD", standard: "$200 – $320 SGD", premium: "$600 – $900 SGD" },
    { category: "Acoustic / Electric Guitar", basic: "$140 – $190 SGD", standard: "$170 – $260 SGD", premium: "$500 – $700 SGD" }
  ];
  providers = [
    { name: "Central Music Academy", locations: "Orchard, Forum, Vivocity", description: "Customized 1-on-1 instrument instruction for children and adult learners." },
    { name: "Regional Sound Studios", locations: "Plaza Singapura, Tampines, Jurong", description: "Structured group classes, exam preparation, and ensemble training." },
    { name: "Heartland Music School", locations: "Toa Payoh, Bedok, Bishan", description: "Accessible private tutoring across neighborhood hubs." }
  ];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={`Official directory, benchmark rates, and recommended services for ${siteName}.`} />
  
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; max-width: 960px; margin: 0 auto; padding: 24px; color: #0f172a; }
    h1 { font-size: 2.2rem; color: #0f172a; margin-bottom: 8px; }
    h2 { font-size: 1.5rem; color: #1e293b; margin-top: 32px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.95rem; }
    th, td { border: 1px solid #cbd5e1; padding: 12px; text-align: left; }
    th { background-color: #f1f5f9; font-weight: 600; }
    .meta-box { background: #f0f9ff; border-left: 4px solid #0284c7; padding: 16px; margin: 24px 0; border-radius: 0 8px 8px 0; }
    .moh-box { background: #fffbe6; border: 1px solid #ffe58f; border-left: 4px solid #faad14; padding: 14px; margin: 20px 0; border-radius: 4px; font-size: 0.88rem; color: #533f03; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0; }
    .card { border: 1px solid #e2e8f0; padding: 16px; border-radius: 8px; background: #fafafa; }
    .form-box { background: #f8fafc; border: 1px solid #cbd5e1; padding: 24px; border-radius: 8px; margin-top: 40px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
    .submit-btn { background: #0284c7; color: white; border: none; padding: 12px 24px; border-radius: 4px; font-weight: 600; cursor: pointer; width: 100%; }
    
    /* Disabled/Greyed-Out WhatsApp Button Style */
    .whatsapp-btn-disabled { 
      background: #94a3b8; 
      color: #f1f5f9; 
      border: none; 
      padding: 12px 24px; 
      border-radius: 4px; 
      font-weight: 600; 
      width: 100%; 
      display: block; 
      text-align: center; 
      text-decoration: none; 
      font-size: 1rem; 
      cursor: not-allowed; 
      opacity: 0.7;
      margin-bottom: 20px;
      box-sizing: border-box;
    }
  </style>
</head>
<body>
  <header style="margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
    <strong>📍 {siteName} Official Portal</strong>
  </header>

  <main>
    <h1>{siteName} Directory & Fee Benchmark 2026</h1>
    
    <div class="meta-box">
      <strong>Market Summary:</strong> {marketSummary}
    </div>

    {mohDisclaimer && (
      <div class="moh-box">
        <strong>⚠️ MOH Healthcare Disclaimer Notice:</strong> Information on this directory is provided for general educational & fee comparison purposes only. In accordance with the Ministry of Health (MOH) Healthcare Services Act (HCSA), this portal does not offer direct medical diagnosis or clinical advice. Consult an MOH-licensed medical practitioner or registered doctor for medical evaluations.
      </div>
    )}

    <h2>1. 2026 Fee & Rate Benchmark</h2>
    <table>
      <thead>
        <tr>
          {tableHeaders.map((header) => <th>{header}</th>)}
        </tr>
      </thead>
      <tbody>
        {tableRows.map((row) => (
          <tr>
            <td><strong>{row.category}</strong></td>
            <td>{row.basic}</td>
            <td>{row.standard}</td>
            <td>{row.premium}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>2. Recommended Providers & Facilities</h2>
    <div class="card-grid">
      {providers.map((p) => (
        <div class="card">
          <h3>{p.name}</h3>
          <p><strong>Locations:</strong> {p.locations}</p>
          <p>{p.description}</p>
        </div>
      ))}
    </div>

    <h2>3. Request Information & Quotation</h2>
    <div class="form-box">
      <p>Connect with accredited providers matching your budget and location requirements for <strong>{siteName}</strong>.</p>

      <!-- Greyed-out WhatsApp Indicator -->
      <div class="whatsapp-btn-disabled" title="WhatsApp support is temporarily offline for updates">
        💬 WhatsApp Support Temporarily Offline
      </div>

      <!-- Active Formspree Email Inquiry Form -->
      <form action="https://formspree.io/f/xkjnrzvk" method="POST">
        <input type="hidden" name="_subject" value={`New Inquiry from ${siteName}`} />
        <input type="hidden" name="site_origin" value={siteName} />
        
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" required placeholder="e.g. Sarah Tan" />
        </div>
        
        <div class="form-group">
          <label for="email">Email or Contact Number</label>
          <input type="text" id="email" name="contact" required placeholder="+65 9123 4567 or email@domain.com" />
        </div>
        
        <div class="form-group">
          <label for="service">Inquiry Scope</label>
          <select id="service" name="service">
            <option value="rate_quote">Request Rate Quotation</option>
            <option value="availability">Check Provider Availability</option>
            <option value="general">General Support</option>
          </select>
        </div>
        
        <button type="submit" class="submit-btn">Submit Request for {siteName}</button>
      </form>
    </div>
  </main>
</body>
</html>

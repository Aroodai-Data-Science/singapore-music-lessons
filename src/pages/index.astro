---
const siteName = import.meta.env.PUBLIC_SITE_NAME || "Singapore Data Hub";
const conversionMode = import.meta.env.PUBLIC_CONVERSION_MODE || "email";
const pageTitle = `${siteName} Directory & Rates 2026`;

// Dynamic location text based on region
const isCebu = siteName.toLowerCase().includes("cebu");
const locationCentral = isCebu ? "Cebu City, IT Park, Ayala Center" : "Orchard, Novena, Marina Bay";
const locationRegional = isCebu ? "Mandaue, Lapu-Lapu, Talisay" : "Jurong, Tampines, Woodlands";
const locationHeartland = isCebu ? "Consolacion, Liloan, Minglanilla" : "Bedok, Toa Payoh, Ang Mo Kio";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={`Official directory, pricing benchmark, and verified listings for ${siteName}.`} />
  
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; max-width: 960px; margin: 0 auto; padding: 24px; color: #0f172a; }
    h1 { font-size: 2.2rem; color: #0f172a; margin-bottom: 8px; }
    h2 { font-size: 1.5rem; color: #1e293b; margin-top: 32px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.95rem; }
    th, td { border: 1px solid #cbd5e1; padding: 12px; text-align: left; }
    th { background-color: #f1f5f9; font-weight: 600; }
    .meta-box { background: #f0f9ff; border-left: 4px solid #0284c7; padding: 16px; margin: 24px 0; border-radius: 0 8px 8px 0; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0; }
    .card { border: 1px solid #e2e8f0; padding: 16px; border-radius: 8px; background: #fafafa; }
    .form-box { background: #f8fafc; border: 1px solid #cbd5e1; padding: 24px; border-radius: 8px; margin-top: 40px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
    .submit-btn { background: #0284c7; color: white; border: none; padding: 12px 24px; border-radius: 4px; font-weight: 600; cursor: pointer; width: 100%; }
    .whatsapp-btn { background: #25D366; color: white; border: none; padding: 14px 24px; border-radius: 4px; font-weight: 700; cursor: pointer; width: 100%; display: block; text-align: center; text-decoration: none; font-size: 1.1rem; }
  </style>
</head>
<body>
  <header style="margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
    <strong>📍 {siteName} Official Portal</strong>
  </header>

  <main>
    <h1>{siteName} Directory & Rates 2026</h1>
    
    <div class="meta-box">
      <strong>Market Summary:</strong> Official pricing benchmark and directory for <strong>{siteName}</strong>. Rates and availability vary based on provider credentials, specialized requirements, and service location.
    </div>

    <h2>1. Estimated Rate Matrix</h2>
    <table>
      <thead>
        <tr>
          <th>Service Tier</th>
          <th>Basic Option</th>
          <th>Standard Package</th>
          <th>Premium / Specialized</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Hourly / Per Visit Rate</strong></td>
          <td>Standard Rates</td>
          <td>Mid-Tier Rates</td>
          <td>Senior Specialist Rates</td>
        </tr>
        <tr>
          <td><strong>Full Package / Monthly</strong></td>
          <td>Entry Plan</td>
          <td>Recommended Plan</td>
          <td>Comprehensive Care/Service</td>
        </tr>
      </tbody>
    </table>

    <h2>2. Regional Service Coverage</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Central District</h3>
        <p><strong>Locations:</strong> {locationCentral}</p>
        <p>Immediate dispatch and priority consultation for core central hubs.</p>
      </div>
      <div class="card">
        <h3>Regional District</h3>
        <p><strong>Locations:</strong> {locationRegional}</p>
        <p>Full suburban coverage with scheduled appointments and consultations.</p>
      </div>
      <div class="card">
        <h3>Heartland / Outer District</h3>
        <p><strong>Locations:</strong> {locationHeartland}</p>
        <p>Accessible, budget-friendly options across local community sectors.</p>
      </div>
    </div>

    <h2>3. Request Information & Direct Inquiry</h2>
    <div class="form-box">
      <p>Connect with top-rated providers for <strong>{siteName}</strong> based on your specific requirements and budget.</p>

      {conversionMode === "whatsapp" ? (
        <div>
          <a href={`https://wa.me/?text=Hi%2C%20I%20am%20inquiring%20about%20services%20on%20${encodeURIComponent(siteName)}`} class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
            💬 Chat via WhatsApp Now
          </a>
        </div>
      ) : (
        <form action="https://formspree.io/f/xkjnrzvk" method="POST">
          <input type="hidden" name="site_origin" value={siteName} />
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" required placeholder="e.g. Sarah Tan" />
          </div>
          <div class="form-group">
            <label for="email">Email or Contact Number</label>
            <input type="text" id="email" name="contact" required placeholder="+65 9123 4567 or email@domain.com" />
          </div>
          <div class="form-group">
            <label for="service">Inquiry Scope</label>
            <select id="service" name="service">
              <option value="rate_quote">Request Rate Quotation</option>
              <option value="availability">Check Provider Availability</option>
              <option value="general">General Support</option>
            </select>
          </div>
          <button type="submit" class="submit-btn">Submit Request for {siteName}</button>
        </form>
      )}
    </div>
  </main>
</body>
</html>
